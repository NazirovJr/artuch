{
  "name": "artuch-staff-desktop",
  "version": "1.0.0",
  "description": "Artuch Staff — Windows desktop shell (Electron wrapper around the Expo web build)",
  "main": "main.js",
  "author": "Artuch Travel",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/NazirovJr/artuch",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "serve-handler": "^6.1.6"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.artuch.staff",
    "productName": "Artuch Staff",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web-build",
        "to": "web-build"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "NazirovJr",
        "repo": "artuch"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Artuch Staff",
      "artifactName": "ArtuchStaff-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ArtuchStaff-Portable-${version}-${arch}.${ext}"
    }
  }
}
