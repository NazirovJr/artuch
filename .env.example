# Copy this file to `.env` (which is gitignored) and fill in real values.
# Used by docker-compose.yml. NEVER commit the real `.env`.

# Postgres
POSTGRES_DB=artuch
POSTGRES_USER=artuch
# Use a strong password. Rotate the live one separately on the server.
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Backend
# Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
NODE_ENV=production

# SMTP (optional) — set to enable real guest emails (confirmations, receipts).
# Leave empty to keep emails as logged stubs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Artuch Travel <noreply@artuch.org>

# Nightly DB backups (db-backup sidecar): how many daily dumps to keep.
BACKUP_KEEP=14
